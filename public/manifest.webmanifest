{
    "name": "Bookworm — a home for readers",
    "short_name": "Bookworm",
    "description": "Your shelf, your reading life and your reading friends.",
    "id": "/",
    "start_url": "/feed?source=app",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#FFF8EF",
    "theme_color": "#4A1220",
    "categories": ["books", "social", "education"],
    "icons": [
        { "src": "/images/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/images/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/images/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "My library", "url": "/library", "icons": [{ "src": "/images/app/icon-192.png", "sizes": "192x192" }] },
        { "name": "Messages", "url": "/messages", "icons": [{ "src": "/images/app/icon-192.png", "sizes": "192x192" }] },
        { "name": "Book clubs", "url": "/clubs", "icons": [{ "src": "/images/app/icon-192.png", "sizes": "192x192" }] }
    ]
}
